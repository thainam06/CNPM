# Copy to .env.docker and replace both placeholders, or use Docker-Demo.ps1 -Action Init.
SMARTTOUR_PORT=8080
SMARTTOUR_ADMIN_USERNAME=admin
SMARTTOUR_ADMIN_PASSWORD=replace-with-a-password-of-at-least-7-characters
SMARTTOUR_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional Supabase PostgreSQL (compose.supabase.yaml). Keep the real value private.
# Use the exact Session pooler host/user from Supabase Connect; never add to VITE_*.
# SUPABASE_CONNECTION_STRING='Host=YOUR-SESSION-POOLER-HOST;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT-REF;Password=YOUR-DATABASE-PASSWORD;SSL Mode=VerifyFull;Timeout=15;Command Timeout=30;Maximum Pool Size=10'
